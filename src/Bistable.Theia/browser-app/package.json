{
  "name": "@bistable/theia-browser",
  "productName": "Bistable IDE",
  "version": "0.1.0",
  "private": true,
  "theia": {
    "frontend": {
      "config": {
        "applicationName": "Bistable IDE",
        "reloadOnReconnect": true,
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "workbench.colorTheme": "Dark (Theia)"
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000,
        "configureProxyFromPreferences": true
      }
    }
  },
  "dependencies": {
    "@bistable/theia-workbench": "0.1.0",
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/file-search": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/keymaps": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/toolbar": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/workspace": "1.73.1"
  },
  "devDependencies": {
    "@theia/cli": "1.73.1"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "clean": "theia clean",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start --hostname=127.0.0.1 --port=3010",
    "start:debug": "npm run start -- --log-level=debug",
    "watch": "npm run rebuild && theia build --watch --mode development"
  }
}
